# Android Signing Configuration
# Copy this file to local.properties and fill in your keystore details
# DO NOT commit local.properties to version control

# Flutter version info (auto-generated by bump_version.py)
flutter.versionName=2.4.0
flutter.versionCode=18

# Keystore signing configuration (for local release builds)
# Comment these out if you only want to build unsigned APKs locally
storeFile=/path/to/your/release-keystore.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
